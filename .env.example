# Copy to .env.local and fill in what you need. Everything is optional for
# local development: with nothing set, the app uses a local Python runner,
# an in-memory rate limiter and a SQLite file in .data/.

# ---------------------------------------------------------------- Code execution (Modal)
# When both are set, user code runs on Modal (modal_app/runner.py).
# When unset, LocalRunner runs code in a local Python subprocess. LocalRunner is
# NOT a secure sandbox: with NODE_ENV=production and no Modal tokens, the app
# refuses to run code.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional: deployed app / function names and Modal environment.
MODAL_APP_NAME=realcode-runner
MODAL_FUNCTION_NAME=run_tests
MODAL_ENVIRONMENT=

# ---------------------------------------------------------------- Rate limiting (Upstash Redis)
# When both are set, rate limits are shared across instances via Upstash.
# When unset, an in-memory limiter is used (per process).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- Database
# Postgres connection string (Supabase works; use the pooler URL).
# When unset, a local SQLite file is used and migrated automatically.
DATABASE_URL=
# Max connections per server instance when using Postgres.
DATABASE_POOL_MAX=5
# Location of the SQLite file when DATABASE_URL is unset.
SQLITE_PATH=.data/realcode.db

# ---------------------------------------------------------------- Admin
# Password for /admin. Defaults to "dev" outside production; in production
# /admin is disabled unless this is set.
ADMIN_PASSWORD=

# ---------------------------------------------------------------- Local development
# Python interpreter used by LocalRunner and the validator.
PYTHON_BIN=python3
# Max concurrent LocalRunner processes.
LOCAL_RUNNER_CONCURRENCY=4
# Where problems are loaded from (defaults to ./problem-bank).
PROBLEM_BANK_DIR=
