[
  {
    "name": "set, get and delete",
    "ops": [
      {"op": "set", "args": ["A", "B", "E"], "expect": null},
      {"op": "set", "args": ["A", "C", "F"], "expect": null},
      {"op": "get", "args": ["A", "B"], "expect": "E"},
      {"op": "get", "args": ["A", "D"], "expect": null},
      {"op": "delete", "args": ["A", "B"], "expect": true},
      {"op": "delete", "args": ["A", "D"], "expect": false},
      {"op": "get", "args": ["A", "B"], "expect": null}
    ]
  },
  {
    "name": "overwrite a field",
    "ops": [
      {"op": "set", "args": ["user1", "name", "ada"], "expect": null},
      {"op": "set", "args": ["user1", "name", "grace"], "expect": null},
      {"op": "get", "args": ["user1", "name"], "expect": "grace"},
      {"op": "get", "args": ["user2", "name"], "expect": null}
    ]
  },
  {
    "name": "get from an empty database",
    "ops": [
      {"op": "get", "args": ["A", "B"], "expect": null}
    ]
  },
  {
    "name": "delete from an empty database",
    "ops": [
      {"op": "delete", "args": ["A", "B"], "expect": false}
    ]
  },
  {
    "name": "records are independent",
    "ops": [
      {"op": "set", "args": ["A", "x", "1"], "expect": null},
      {"op": "set", "args": ["B", "x", "2"], "expect": null},
      {"op": "get", "args": ["A", "x"], "expect": "1"},
      {"op": "get", "args": ["B", "x"], "expect": "2"},
      {"op": "delete", "args": ["A", "x"], "expect": true},
      {"op": "get", "args": ["B", "x"], "expect": "2"}
    ]
  },
  {
    "name": "delete twice",
    "ops": [
      {"op": "set", "args": ["A", "x", "1"], "expect": null},
      {"op": "delete", "args": ["A", "x"], "expect": true},
      {"op": "delete", "args": ["A", "x"], "expect": false},
      {"op": "get", "args": ["A", "x"], "expect": null}
    ]
  },
  {
    "name": "set after delete",
    "ops": [
      {"op": "set", "args": ["A", "x", "1"], "expect": null},
      {"op": "delete", "args": ["A", "x"], "expect": true},
      {"op": "set", "args": ["A", "x", "2"], "expect": null},
      {"op": "get", "args": ["A", "x"], "expect": "2"}
    ]
  },
  {
    "name": "empty strings are valid",
    "ops": [
      {"op": "set", "args": ["", "", ""], "expect": null},
      {"op": "get", "args": ["", ""], "expect": ""},
      {"op": "delete", "args": ["", ""], "expect": true},
      {"op": "get", "args": ["", ""], "expect": null}
