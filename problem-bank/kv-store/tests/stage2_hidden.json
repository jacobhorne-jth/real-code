[
  {
    "name": "scan by prefix",
    "ops": [
      {"op": "set", "args": ["A", "BC", "E"], "expect": null},
      {"op": "set", "args": ["A", "BD", "F"], "expect": null},
      {"op": "set", "args": ["A", "C", "G"], "expect": null},
      {"op": "scan_by_prefix", "args": ["A", "B"], "expect": ["BC(E)", "BD(F)"]},
      {"op": "scan", "args": ["A"], "expect": ["BC(E)", "BD(F)", "C(G)"]},
      {"op": "scan_by_prefix", "args": ["B", "B"], "expect": []}
    ]
  },
  {
    "name": "scan is sorted by field",
    "ops": [
      {"op": "set", "args": ["user", "zip", "94110"], "expect": null},
      {"op": "set", "args": ["user", "age", "36"], "expect": null},
      {"op": "set", "args": ["user", "city", "SF"], "expect": null},
      {"op": "scan", "args": ["user"], "expect": ["age(36)", "city(SF)", "zip(94110)"]}
    ]
  },
  {
    "name": "scan a missing record",
    "ops": [
      {"op": "scan", "args": ["nope"], "expect": []},
      {"op": "scan_by_prefix", "args": ["nope", "a"], "expect": []}
    ]
  },
  {
    "name": "scan after deletes",
    "ops": [
      {"op": "set", "args": ["A", "a", "1"], "expect": null},
      {"op": "set", "args": ["A", "b", "2"], "expect": null},
      {"op": "set", "args": ["A", "c", "3"], "expect": null},
      {"op": "delete", "args": ["A", "b"], "expect": true},
      {"op": "scan", "args": ["A"], "expect": ["a(1)", "c(3)"]},
      {"op": "delete", "args": ["A", "a"], "expect": true},
      {"op": "delete", "args": ["A", "c"], "expect": true},
      {"op": "scan", "args": ["A"], "expect": []}
    ]
  },
  {
    "name": "prefix equal to a field name",
    "ops": [
      {"op": "set", "args": ["A", "ab", "1"], "expect": null},
      {"op": "set", "args": ["A", "abc", "2"], "expect": null},
      {"op": "set", "args": ["A", "abd", "3"], "expect": null},
      {"op": "set", "args": ["A", "b", "4"], "expect": null},
      {"op": "scan_by_prefix", "args": ["A", "ab"], "expect": ["ab(1)", "abc(2)", "abd(3)"]},
      {"op": "scan_by_prefix", "args": ["A", "abc"], "expect": ["abc(2)"]},
      {"op": "scan_by_prefix", "args": ["A", "abcd"], "expect": []}
    ]
  },
  {
    "name": "empty prefix matches everything",
    "ops": [
      {"op": "set", "args": ["A", "b", "1"], "expect": null},
      {"op": "set", "args": ["A", "a", "2"], "expect": null},
      {"op": "scan_by_prefix", "args": ["A", ""], "expect": ["a(2)", "b(1)"]}
    ]
  },
  {
    "name": "overwritten values show up in scans",
    "ops": [
      {"op": "set", "args": ["A", "k", "old"], "expect": null},
      {"op": "set", "args": ["A", "k", "new"], "expect": null},
      {"op": "scan", "args": ["A"], "expect": ["k(new)"]}
    ]
  },
  {
    "name": "lexicographic, not numeric, order",
    "ops": [
      {"op": "set", "args": ["A", "10", "x"], "expect": null},
      {"op": "set", "args": ["A", "9", "y"], "expect": null},
      {"op": "set", "args": ["A", "1", "z"], "expect": null},
      {"op": "set", "args": ["A", "Z", "upper"], "expect": null},
      {"op": "set", "args": ["A", "a", "lower"], "expect": null},
      {"op": "scan", "args": ["A"], "expect": ["1(z)", "10(x)", "9(y)", "Z(upper)", "a(lower)"]}
    ]
  },
  {
    "name": "records are scanned independently",
    "ops": [
      {"op": "set", "args": ["A", "x", "1"], "expect": null},
      {"op": "set", "args": ["B", "x", "2"], "expect": null},
      {"op": "set", "args": ["B", "y", "3"], "expect": null},
      {"op": "scan", "args": ["A"], "expect": ["x(1)"]},
      {"op": "scan", "args": ["B"], "expect": ["x(2)", "y(3)"]}
    ]
  },
